{
  "_comment": "OBS NVENC 720p25 配置样例 — 手动导入 OBS 后参照本文件设置, OBS 本身不读此文件",
  "output": {
    "mode": "advanced",
    "encoder": "NVENC H.264 (new)",
    "preset": "P5 (slowest, best quality)",
