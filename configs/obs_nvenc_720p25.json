  "video": {
    "base_canvas": "1920x1080",
    "output_resolution": "1280x720",
    "fps": {"common": "25"}
  },
  "audio": {
    "sample_rate": 44100,
    "bitrate_kbps": 160,
    "encoder": "ffmpeg_aac"
  },
  "advanced": {
    "renderer": "Direct3D 11",
    "color_format": "NV12",
    "color_space": "709",
    "gpu_index": 0
